{
	"info": {
		"_postman_id": "quiz-submissions-api-collection",
		"name": "Quiz Submissions API",
		"description": "API collection for quiz submissions, scoring, and history management",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login to get JWT Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Student123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Quiz Submissions",
			"item": [
				{
					"name": "Submit Quiz",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quizId\": \"quiz-1\",\n  \"chapterId\": \"74a14643-1495-401f-a42d-9a4216beb862\",\n  \"timeTakenSeconds\": 900,\n  \"answers\": [\n    {\n      \"questionId\": \"q1-1\",\n      \"answer\": \"D\",\n      \"timeTakenSeconds\": 60\n    },\n    {\n      \"questionId\": \"q1-2\",\n      \"answer\": \"true\",\n      \"timeTakenSeconds\": 45\n    },\n    {\n      \"questionId\": \"q1-3\",\n      \"answer\": \"B\",\n      \"timeTakenSeconds\": 90\n    },\n    {\n      \"questionId\": \"q1-4\",\n      \"answer\": \"reactants\",\n      \"timeTakenSeconds\": 30\n    },\n    {\n      \"questionId\": \"q1-5\",\n      \"answer\": \"C\",\n      \"timeTakenSeconds\": 75\n    },\n    {\n      \"questionId\": \"q1-6\",\n      \"answer\": \"false\",\n      \"timeTakenSeconds\": 40\n    },\n    {\n      \"questionId\": \"q1-7\",\n      \"answer\": \"B\",\n      \"timeTakenSeconds\": 60\n    },\n    {\n      \"questionId\": \"q1-8\",\n      \"answer\": \"products\",\n      \"timeTakenSeconds\": 35\n    },\n    {\n      \"questionId\": \"q1-9\",\n      \"answer\": \"C\",\n      \"timeTakenSeconds\": 80\n    },\n    {\n      \"questionId\": \"q1-10\",\n      \"answer\": \"true\",\n      \"timeTakenSeconds\": 50\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/quizsubmission/submit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"quizsubmission",
								"submit"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Quiz Submission by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/quizsubmission/submission/{{submission_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
