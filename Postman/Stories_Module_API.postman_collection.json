    {
      "name": "📚 Stories Management",
      "item": [
        {
          "name": "Create New Story",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to Chemistry\",\n  \"description\": \"Learn the basics of chemistry with this comprehensive video\",\n  \"category\": \"Science\",\n  \"subcategory\": \"Chemistry\",\n  \"tags\": [\"chemistry\", \"science\", \"education\"],\n  \"durationSeconds\": 1800,\n  \"fileSizeBytes\": 52428800,\n  \"isPremium\": false,\n  \"thumbnailUrl\": \"https://example.com/thumbnail.jpg\",\n  \"videoUrl\": \"https://example.com/video.mp4\",\n  \"metadata\": {\n    \"difficulty\": \"Beginner\",\n    \"targetAudience\": \"High School Students\",\n    \"prerequisites\": [\"Basic Math\"],\n    \"learningObjectives\": [\"Understand atomic structure\", \"Learn chemical bonding\"]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/VideoStreaming/stories",
              "host": ["{{base_url}}"],
              "path": ["api", "VideoStreaming", "stories"]
            },
            "description": "Create a new story/video entry. The response will include the story ID - copy this to the 'story_id' variable for other requests."
          },
          "response": []
        },
        {
          "name": "Get All Stories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/VideoStreaming/stories?page=1&pageSize=10&category=Science&isPremium=false",
              "host": ["{{base_url}}"],
              "path": ["api", "VideoStreaming", "stories"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "category",
                  "value": "Science"
                },
                {
                  "key": "isPremium",
                  "value": "false"
                }
              ]
            },
            "description": "Get a paginated list of stories with optional filtering by category and premium status."
