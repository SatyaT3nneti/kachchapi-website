{
	"info": {
		"_postman_id": "oauth-api-collection",
		"name": "OAuth Authentication API",
		"description": "Complete OAuth authentication flow for Google and GitHub providers",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "OAuth Providers",
			"item": [
				{
					"name": "Get OAuth Providers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/oauth/providers",
							"host": ["{{baseUrl}}"],
							"path": ["api", "oauth", "providers"]
						},
						"description": "Get list of available OAuth providers and their status"
					},
					"response": []
				}
			]
		},
		{
			"name": "Google OAuth",
			"item": [
				{
					"name": "Get Google OAuth URL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"provider\": \"google\",\n  \"redirectUri\": \"https://localhost:7001/api/auth/callback\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/oauth/auth-url",
							"host": ["{{baseUrl}}"],
							"path": ["api", "oauth", "auth-url"]
						},
						"description": "Get Google OAuth authorization URL"
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.authUrl) {",
									"        pm.collectionVariables.set('googleAuthUrl', response.authUrl);",
									"        console.log('Google OAuth URL:', response.authUrl);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Login with Google OAuth",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"provider\": \"google\",\n  \"code\": \"{{googleAuthCode}}\",\n  \"redirectUri\": \"https://localhost:7001/api/auth/callback\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/oauth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "oauth", "login"]
						},
						"description": "Login with Google OAuth authorization code"
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.token) {",
									"        pm.collectionVariables.set('accessToken', response.token);",
									"        pm.collectionVariables.set('refreshToken', response.refreshToken);",
									"        console.log('Google OAuth login successful');",
									"        console.log('Is new user:', response.isNewUser);",
									"        console.log('Provider:', response.provider);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
