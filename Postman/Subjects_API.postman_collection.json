						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/subjects?pageNumber=1&pageSize=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"subjects"
					],
					"query": [
						{
							"key": "pageNumber",
							"value": "1"
						},
						{
							"key": "pageSize",
							"value": "10"
						}
					]
				}
			}
		},
