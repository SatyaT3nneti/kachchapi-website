						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"pageNumber\": 1,\n  \"pageSize\": 10,\n  \"filters\": [\n    {\n      \"column\": \"subjectName\",\n      \"operator\": \"contains\",\n      \"value\": \"Math\"\n    }\n  ],\n  \"sortBy\": \"subjectName\",\n  \"sortDescending\": false\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/subjects/search",
