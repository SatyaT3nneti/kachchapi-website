            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"syllabusContent\": \"This chapter covers the fundamentals of business statistics including descriptive statistics, probability distributions, hypothesis testing, and regression analysis. Students will learn to analyze data using spreadsheet tools and interpret statistical results for business decision-making.\",\n  \"preferences\": {\n    \"difficultyLevel\": \"Medium\",\n    \"validUntil\": \"2024-12-31T23:59:59Z\",\n    \"totalQuestions\": 15,\n    \"examDuration\": 90,\n    \"passPercentage\": 60.0,\n    \"questionTypes\": [\n      {\n        \"type\": \"Objective\",\n        \"count\": 10\n      },\n      {\n        \"type\": \"Descriptive\",\n        \"count\": 3\n      },\n      {\n        \"type\": \"YesNo\",\n        \"count\": 2\n      }\n    ]\n  },\n  \"attachments\": null,\n  \"files\": [\n    {\n      \"fileName\": \"syllabus.pdf\",\n      \"fileContent\": \"JVBERi0xLjQKJcOkw7zDtsO...\",\n      \"fileType\": \"application/pdf\"\n    },\n    {\n      \"fileName\": \"chapter1.docx\",\n      \"fileContent\": \"UEsDBBQAAAAIAA...\",\n      \"fileType\": \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\"\n    },\n    {\n      \"fileName\": \"diagram.png\",\n      \"fileContent\": \"iVBORw0KGgoAAAANSUhEUgAA...\",\n      \"fileType\": \"image/png\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/exam/generate-questions",
          "host": ["{{base_url}}"],
          "path": ["api", "exam", "generate-questions"]
        },
        "description": "Generate exam questions using AI from syllabus content"
