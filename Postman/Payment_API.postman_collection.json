							"raw": "{\n  \"paymentType\": \"one_time\",\n  \"planName\": \"Premium Course\",\n  \"amount\": 999.00,\n  \"currency\": \"INR\",\n  \"description\": \"Premium course access for 1 year\",\n  \"receiptNumber\": \"receipt_001\"\n}"
